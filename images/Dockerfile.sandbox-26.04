# pats sandbox image: ubuntu 26.04 + the tooling agents habitually reach for
# (git, curl, python3, ripgrep, node), and no harness cli: pats places the
# ones a sandbox's agents run when it makes the sandbox's image, so a
# `build:` dockerfile on `FROM ${PATS_SANDBOX}` brings its own. published to
# ghcr.io/lczyk/pats/sandbox:v<version> on tag push (publish_images
# workflow), with :latest following the newest stable release.
#
# the install steps live in images/provision-sandbox.sh, which the lxd driver
# runs on a fresh ubuntu instance too, so both sandboxes carry the same tools.
FROM docker.io/library/ubuntu:26.04

COPY images/provision-sandbox.sh /tmp/provision/
RUN sh /tmp/provision/provision-sandbox.sh && rm -r /tmp/provision

CMD ["/bin/bash"]
