# pats sandbox image: ubuntu 26.04 + agent harness clis + the tooling agents
# habitually reach for (git, curl, python3, ripgrep). usable out of the box as
# a pats sandbox, and as a base for task-specific images -- e.g. mason's adds
# chisel + dpkg-dev on top (`ARG PATS_SANDBOX` / `FROM ${PATS_SANDBOX}` gets the
# version pats passes in). published to ghcr.io/lczyk/pats/sandbox:v<version>
# on tag push (publish_images workflow), with :latest following the newest
# stable release.
#
# the install steps live in images/provision-sandbox.sh, which the lxd driver
# runs on a fresh ubuntu instance too, so both sandboxes carry the same tools.
FROM docker.io/library/ubuntu:26.04

ARG CLAUDE_CLI_VERSION=latest
ARG CODEX_CLI_VERSION=latest
ARG COPILOT_CLI_VERSION=latest
ARG OPENCODE_VERSION=latest
COPY images/provision-sandbox.sh /tmp/provision-sandbox.sh
RUN CLAUDE_CLI_VERSION="$CLAUDE_CLI_VERSION" CODEX_CLI_VERSION="$CODEX_CLI_VERSION" \
    COPILOT_CLI_VERSION="$COPILOT_CLI_VERSION" \
    OPENCODE_VERSION="$OPENCODE_VERSION" sh /tmp/provision-sandbox.sh && \
    rm /tmp/provision-sandbox.sh

CMD ["/bin/bash"]
